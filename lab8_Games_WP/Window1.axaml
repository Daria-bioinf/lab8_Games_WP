<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab8_Games_WP.Window1"
        Title="Window1">
	<StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

		<TextBlock Text="Karciane Kasyno 🃏" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>

		<Border BorderBrush="Gray" BorderThickness="1" Padding="15" CornerRadius="5">
			<StackPanel Spacing="10">
				<TextBlock Text="Dodaj gracza (Login / ID):" FontWeight="Bold"/>
				<TextBox x:Name="txtLogin" Width="200" Watermark="Wpisz nick..."/>
				<Button Content="Dodaj Gracza" Click="BtnDodajGracza_Click" HorizontalAlignment="Center" Background="LightGreen"/>
				<TextBlock x:Name="txtObecnyGracz" Text="Obecny gracz: Brak" Foreground="Gray" HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>

		<TextBlock Text="Wybierz grę:" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
		<StackPanel Spacing="10" HorizontalAlignment="Center">
			<Button Content="Gra 1: Więcej czy Mniej" Click="BtnGra1_Click" Width="220" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
			<Button Content="Gra 2: Wojna" Click="BtnGra2_Click" Width="220" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
			<Button Content="Gra 3: Oczko (21)" Click="BtnGra3_Click" Width="220" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
			<Button Content="📜 Historia rozgrywek" Click="BtnHistoria_Click" Width="220" HorizontalContentAlignment="Center" Margin="0,20,0,0" Background="LightBlue"/>
		</StackPanel>

		

	</StackPanel>
</Window>
