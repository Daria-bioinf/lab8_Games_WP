<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab8_Games_WP.HistoryWindow"
        Title="HistoryWindow">
	<StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

		<TextBlock Text="📜 Historia Rozgrywek i Wygranych" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Gold"/>

		<ListBox x:Name="lstHistory" Height="300" Width="400" CornerRadius="5" Background="#1E1E1E">
			<ListBoxItem Content="[12:00] Gracz1 - Więcej/Mniej - Wygrana"/>
			<ListBoxItem Content="[12:05] Gracz1 - Wojna - Przegrana"/>
		</ListBox>

		<Button Content="Zamknij" Click="BtnZamknij_Click" HorizontalAlignment="Center" Width="150" HorizontalContentAlignment="Center" Background="IndianRed" Foreground="White" Margin="0,10,0,0"/>

	</StackPanel>
</Window>
