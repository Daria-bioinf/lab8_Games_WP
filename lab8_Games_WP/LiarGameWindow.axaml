<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="lab8_Games_WP.LiarGameWindow"
        Title="LiarGameWindow">
	<StackPanel Margin="20" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">

		<TextBlock Text="Gra: Liar's Game 🤥" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="MediumPurple"/>

		<StackPanel Spacing="10" HorizontalAlignment="Center">
			<Border x:Name="brdCard" BorderBrush="White" BorderThickness="3" CornerRadius="15" Width="120" Height="180" Background="#333333">
				<TextBlock x:Name="txtCardValue" Text="?" FontSize="60" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
			</Border>

			<Border Background="#444444" Padding="10" CornerRadius="5">
				<TextBlock x:Name="txtClaim" Text="Komputer mówi: To jest As!" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Yellow"/>
			</Border>
		</StackPanel>

		<TextBlock x:Name="txtStatus" Text="Czy on kłamie?" FontSize="16" HorizontalAlignment="Center"/>
		<TextBlock x:Name="txtScore" Text="Punkty: 0" FontSize="14" HorizontalAlignment="Center" Foreground="Gray"/>

		<StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
			<Button Content="Wierzę! ✅" Click="BtnBelieve_Click" Width="130" Height="50" Background="DarkGreen" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
			<Button Content="Kłamstwo! ❌" Click="BtnLiar_Click" Width="130" Height="50" Background="DarkRed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
		</StackPanel>

		<Button Content="Następna runda" Click="BtnNext_Click" HorizontalAlignment="Center" IsEnabled="False" x:Name="btnNext"/>

	</StackPanel>
</Window>
